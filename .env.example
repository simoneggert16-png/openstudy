# Copy this file to .env.local (git-ignored) if you want pre-filled local defaults.
# You can also enter keys directly inside the OpenStudy UI (stored only in your local browser).

# Free-tier Google AI Studio API key (get one free at https://aistudio.google.com/apikey)
VITE_GEMINI_API_KEY=

# Optional local companion bridge URL (default: http://127.0.0.1:4319)
VITE_BRIDGE_URL=http://127.0.0.1:4319

# Optional local Ollama endpoint for 100% offline, zero-cost AI
VITE_OLLAMA_URL=http://127.0.0.1:11434
